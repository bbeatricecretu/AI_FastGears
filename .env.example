# Copy to .env and fill in. Never commit .env.

# ── LLM (R2: in-car reaction) ─────────────────────────────
LLM_PROVIDER=gemini            # gemini | anthropic | none (rule-based only)
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
PHONE_VISION_CHECK=0           # opt-in to send hand crops to Gemini for phone confirmation
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
LLM_MIN_INTERVAL_S=8           # min seconds between LLM calls on state changes
LLM_SUMMARY_EVERY_S=45         # calm periodic check-in
ASSISTANT_LANGUAGE=English

# ── Camera ────────────────────────────────────────────────
CAMERA=0                       # webcam index, or a video file path for dev replay only
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
MIRROR=1

# ── Detectors ─────────────────────────────────────────────
ENABLE_RPPG=1                  # camera pulse (needs white light, still face)
ENABLE_OBJECTS=1               # YOLOv8n phone detection
ENABLE_HANDS=1                 # MediaPipe hand detection
DRIVER_SEAT=auto               # auto | left | right, in the displayed frame
YOLO_MODEL=yolov8n.pt
YOLO_EVERY=3                   # run YOLO every N frames
CALIBRATION_S=5                # look at the road for N s at start
DISCOMFORT_OVERLAP_S=0.3       # minimum simultaneous facial movement, in seconds
ENABLE_RGB=0                   # experimental facial colour measurements
RGB_REFERENCE=                 # optional matte neutral patch x0,y0,x1,y1. Empty uses the forehead.
RGB_OVERLAY=0                  # draw the RGB sampling masks
RGB_CALIBRATION_S=5
RGB_PERSISTENCE_S=1

# ── Server ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# Episode and pattern timing (seconds)
PATTERN_WINDOW_S=30
PATTERN_COUNT=3
PATTERN_MIN_S=0.45
PATTERN_RECOVERY_S=0.25
PATTERN_GROWTH_S=0.25
PATTERN_COOLDOWN_S=12
PATTERN_SUPPORT=3
ALERT_HOLD_S=4
